{
  "name": "mas-investigation-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check:code": "npm run format:check && npm run lint && npm run typecheck",
    "preview": "vite preview",
    "check:readability-browser": "node scripts/check_readability_browser.mjs",
    "check:readability": "node scripts/check_readability.mjs",
    "check:mc2-browser": "node scripts/check_mc2_browser.mjs",
    "check:mc2-controls": "node scripts/check_mc2_controls_browser.mjs",
    "check:mc2-optimizations": "node scripts/check_mc2_optimizations.mjs",
    "check:mc1": "node scripts/check_mc1.mjs",
    "check:mc2": "node scripts/check_mc2.mjs",
    "check:custom": "node scripts/check_custom.mjs",
    "check:snapshot-compatibility": "node scripts/check_snapshot_compatibility.mjs",
    "check:navigation": "node scripts/check_navigation.mjs"
  },
  "dependencies": {
    "cytoscape": "^3.35.0",
    "d3": "^7.9.0",
    "d3-force": "^3.0.1",
    "d3-scale": "^4.0.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/cytoscape": "^3.21.9",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.46.3",
    "vite": "^5.4.10"
  }
}
